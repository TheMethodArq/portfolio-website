{
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "ignore": [
        "firebase.json",
        ".**",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/blog/why-we-built-sophia-code",
          "destination": "/blog/meet-sophia-governance-layer",
          "type": 301
        },
        {
          "source": "/blog/why-we-built-sophia-code/**",
          "destination": "/blog/meet-sophia-governance-layer",
          "type": 301
        },
        {
          "source": "/products/cerebrum/**",
          "destination": "/platform/synaptica/",
          "type": 301
        },
        {
          "source": "/products/sophia/**",
          "destination": "/platform/sophia-assistant/",
          "type": 301
        },
        {
          "source": "/early-access/**",
          "destination": "/early-bird/",
          "type": 301
        },
        {
          "source": "/home/**",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/about/**",
          "destination": "/company/about/",
          "type": 301
        },
        {
          "source": "/team/**",
          "destination": "/company/team/",
          "type": 301
        },
        {
          "source": "/products/**",
          "destination": "/platform/",
          "type": 301
        },
        {
          "source": "/product/**",
          "destination": "/platform/",
          "type": 301
        },
        {
          "source": "/solutions/aso/**",
          "destination": "/aso/",
          "type": 301
        },
        {
          "source": "/platform/sophia/**",
          "destination": "/sophia/",
          "type": 301
        },
        {
          "source": "/synaptica/**",
          "destination": "/platform/synaptica/",
          "type": 301
        },
        {
          "source": "/early-bird/**",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/founders/**",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/products/sophiaclaw-community/**",
          "destination": "/solutions/development/community/",
          "type": 301
        },
        {
          "source": "/products/sophiaclaw-pro/**",
          "destination": "/solutions/agent-assisted/sophiaclaw-pro/",
          "type": 301
        },
        {
          "source": "/platform/executioniq/**",
          "destination": "/solutions/agent-assisted/executioniq/",
          "type": 301
        },
        {
          "source": "/platform/synaptica/**",
          "destination": "/solutions/platform/synaptica/",
          "type": 301
        },
        {
          "source": "/platform/aso/**",
          "destination": "/solutions/platform/aso/",
          "type": 301
        },
        {
          "source": "/blog/hub/:slug",
          "destination": "/blog/category/:slug",
          "type": 301
        },
        {
          "source": "/blog/spoke/:slug",
          "destination": "/blog/:slug",
          "type": 301
        }
      ],
      "cleanUrls": true,
      "trailingSlash": true,
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|PNG|jpg|JPG|jpeg|JPEG|gif|GIF|webp|WEBP|svg|SVG|ico|ICO)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/fonts/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
            },
            {
              "key": "X-DNS-Prefetch-Control",
              "value": "on"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://www.google-analytics.com; connect-src 'self' https://litlyx-producer-w3jdci4rwq-uc.a.run.app https://www.google-analytics.com https://*.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
            }
          ]
        }
      ]
    },
    {
      "target": "www-redirect",
      "public": "dist",
      "ignore": [
        "firebase.json",
        ".**",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://getthalamus.ai/:path",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://getthalamus.ai/",
          "type": 301
        }
      ]
    }
  ]
}
